  "response": "## Analyse\n\nJe dois créer `tests/test_summarize.py` avec 4 tests couvrant les cas limites : texte vide, texte court, texte long, et max_sentences=1. D'abord, je valide que `tools/summarize.py` est importable et contient les fonctions requises.\n\n**Diagnostic préalable** :\n```bash\npython -c \"from tools.summarize import summarize, split_sentences, score_sentence; print('✓ Imports OK')\"\n```\n\nPuis je génère les tests avec pytest, en m'assurant que chaque test est COMPLET et exécutable.\n\n---\n\n## Code\n\n```python path: tests/test_summarize.py\n\"\"\"Tests for tools/summarize.py\"\"\"\nimport pytest\nfrom tools.summarize import summarize, split_sentences, score_sentence\n\n\nclass TestEmptyText:\n    \"\"\"Test handling of empty or whitespace-only text.\"\"\"\n    \n    def test_empty_string(self):\n        \"\"\"Empty string should return empty string.\"\"\"\n        result = summarize(\"\")\n        assert result == \"\"\n    \n    def test_whitespace_only(self):\n        \"\"\"Whitespace-only text should return empty string.\"\"\"\n        result = summarize(\"   \\n\\t  \")\n        assert result == \"\"\n\n\nclass TestShortText:\n    \"\"\"Test text shorter than max_sentences.\"\"\"\n    \n    def test_short_text_single_sentence(self):\n        \"\"\"Single sentence should be returned as-is.\"\"\"\n        text = \"This is a single sentence.\"\n        result = summarize(text, max_sentences=3)\n        assert result == text\n    \n    def test_short_text_two_sentences(self):\n        \"\"\"Two sentences with max_sentences=5 should return both.\"\"\"\n        text = \"First sentence. Second sentence.\"\n        result = summarize(text, max_sentences=5)\n        assert result == text\n\n\nclass TestLongText:\n    \"\"\"Test text longer than max_sentences.\"\"\"\n    \n    def test_long_text_truncated(self):\n        \"\"\"Long text should be summarized to max_sentences.\"\"\"\n        text = \"Sentence one. Sentence two. Sentence three. Sentence four. Sentence five.\"\n        result = summarize(text, max_sentences=2)\n        sentences = split_sentences(result)\n        assert len(sentences) <= 2\n        assert \"Sentence\" in result\n    \n    def test_long_text_default_max(self):\n        \"\"\"Long text with default max_sentences should be summarized.\"\"\"\n        text = \". \".join([f\"Sentence {i}\" for i in range(1, 11)]) + \".\"\n        result = summarize(text)\n        sentences = split_sentences(result)\n        assert len(sentences) > 0\n        assert len(sentences) <= 5  # default max_sentences\n\n\nclass TestMaxSentencesOne:\n    \"\"\"Test edge case: max_sentences=1.\"\"\"\n    \n    def test_max_sentences_one(self):\n        \"\"\"max_sentences=1 should return only the top-scored sentence.\"\"\"\n        text = \"First sentence. Second sentence. Third sentence.\"\n        result = summarize(text, max_sentences=1)\n        sentences = split_sentences(result)\n        assert len(sentences) == 1\n        assert result.strip() != \"\"\n\n\nclass TestSplitSentences:\n    \"\"\"Test split_sentences helper function.\"\"\"\n    \n    def test_split_basic(self):\n        \"\"\"Basic sentence splitting on periods.\"\"\"\n        text = \"First. Second. Third.\"\n        sentences = split_sentences(text)\n        assert len(sentences) >= 2\n    \n    def test_split_empty(self):\n        \"\"\"Empty text should return empty list or list with empty string.\"\"\"\n        sentences = split_sentences(\"\")\n        assert len(sentences) == 0 or sentences == [\"\"]\n\n\nclass TestScoreSentence:\n    \"\"\"Test score_sentence helper function.\"\"\"\n    \n    def test_score_non_empty(self):\n        \"\"\"Non-empty sentence should have a score.\"\"\"\n        score = score_sentence(\"This is a test sentence.\")\n        assert isinstance(score, (int, float))\n        assert score >= 0\n    \n    def test_score_empty(self):\n        \"\"\"Empty sentence should have zero or low score.\"\"\"\n        score = score_sentence(\"\")\n        assert isinstance(score, (int, float))\n        assert score >= 0\n```\n\n---\n\n## Validation\n\n```bash\npython -m pytest tests/test_summarize.py -v\n```\n\n**Vérifications supplémentaires** :\n```bash\npython -m py_compile tests/test_summarize.py && echo \"✓ Syntax OK\"\ntail -5 tests/test_summarize.py && echo \"✓ File complete\"\n```",
