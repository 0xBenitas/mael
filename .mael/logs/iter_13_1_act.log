e is not None\n    assert hasattr(initial_state, 'version')\n    assert hasattr(initial_state, 'data')\n\ndef test_state_attributes(initial_state):\n    \"\"\"Test des attributs de l'état chargé.\"\"\"\n    assert initial_state.version == \"1.0.0\"\n    assert initial_state.is_valid is True\n    assert initial_state.timestamp is not None\n\ndef test_state_data_structure(initial_state):\n    \"\"\"Test de la structure des données d'état.\"\"\"\n    assert isinstance(initial_state.data, dict)\n    assert \"config\" in initial_state.data\n    assert \"status\" in initial_state.data\n\ndef test_state_manager_integration(state_manager):\n    \"\"\"Test d'intégration du gestionnaire d'état.\"\"\"\n    state = state_manager.load_state()\n    assert state is not None\n    assert state.is_valid is True\n    \n    # Test de sauvegarde\n    result = state_manager.save_state(state)\n    assert result is True\n\ndef test_state_persistence_cycle(state_manager):\n    \"\"\"Test du cycle complet chargement/sauvegarde.\"\"\"\n    # Charger l'état\n    original_state = state_manager.load_state()\n    assert original_state.version == \"1.0.0\"\n    \n    # Sauvegarder\n    save_result = state_manager.save_state(original_state)\n    assert save_result is True\n    \n    # Recharger\n    reloaded_state = state_manager.load_state()\n    assert reloaded_state.version == original_state.version\n```\n\n```bash\npytest tests/test_integration.py -v\n```",
