  "response": "## Analyse\nJe dois améliorer tools/summarize.py avec un scoring TF-IDF simplifié basé sur la fréquence des mots. Je vais d'abord examiner le code existant, puis implémenter le scoring TF avec calcul des fréquences de mots pour prioriser les phrases contenant les termes les plus fréquents.\n\n```python path: tools/summarize.py\nimport re\nfrom collections import Counter\nimport string\n\ndef get_word_frequencies(text):\n    \"\"\"Calculate word frequencies in the text.\"\"\"\n    # Convert to lowercase and remove punctuation\n    text = text.lower()\n    # Remove punctuation and split into words\n    words = re.findall(r'\\b[a-zA-Z]+\\b', text)\n    # Filter out common stop words\n    stop_words = {'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'by', 'is', 'are', 'was', 'were', 'be', 'been', 'have', 'has', 'had', 'do', 'does', 'did', 'will', 'would', 'could', 'should', 'may', 'might', 'must', 'can', 'this', 'that', 'these', 'those', 'i', 'you', 'he', 'she', 'it', 'we', 'they', 'me', 'him', 'her', 'us', 'them'}\n    filtered_words = [word for word in words if word not in stop_words and len(word) > 2]\n    return Counter(filtered_words)\n\ndef split_sentences(text):\n    \"\"\"Split text into sentences.\"\"\"\n    # Simple sentence splitting on periods, exclamation marks, and question marks\n    sentences = re.split(r'[.!?]+', text)\n    # Clean up sentences and filter out empty ones\n    sentences = [s.strip() for s in sentences if s.strip()]\n    return sentences\n\ndef score_sentence(sentence, word_frequencies):\n    \"\"\"Score a sentence based on word frequencies (TF scoring).\"\"\"\n    if not sentence.strip():\n        return 0.0\n    \n    words = re.findall(r'\\b[a-zA-Z]+\\b', sentence.lower())\n    if not words:\n        return 0.0\n    \n    # Calculate score as sum of word frequencies divided by sentence length\n    score = sum(word_frequencies.get(word, 0) for word in words)\n    return score / len(words)  # Normalize by sentence length\n\ndef summarize(text, max_sentences=3):\n    \"\"\"Summarize text using TF-based sentence scoring.\"\"\"\n    if not text or not text.strip():\n        return \"\"\n    \n    sentences = split_sentences(text)\n    if len(sentences) <= max_sentences:\n        return text.strip()\n    \n    # Get word frequencies for TF scoring\n    word_frequencies = get_word_frequencies(text)\n    \n    # Score each sentence\n    sentence_scores = []\n    for sentence in sentences:\n        score = score_sentence(sentence, word_frequencies)\n        sentence_scores.append((sentence, score))\n    \n    # Sort by score (descending) and take top sentences\n    sentence_scores.sort(key=lambda x: x[1], reverse=True)\n    top_sentences = sentence_scores[:max_sentences]\n    \n    # Return sentences in original order\n    selected_sentences = [sent for sent, _ in top_sentences]\n    # Find original order\n    result_sentences = []\n    for original_sentence in sentences:\n        if original_sentence in selected_sentences:\n            result_sentences.append(original_sentence)\n            selected_sentences.remove(original_sentence)\n    \n    return '. '.join(result_sentences) + '.'\n\nif __name__ == \"__main__\":\n    # Simple test\n    test_text = \"This is a test. This test is important. Another sentence here. The test shows functionality.\"\n    result = summarize(test_text, 2)\n    print(f\"Original: {test_text}\")\n    print(f\"Summary: {result}\")\n```\n\n```bash\npython tools/summarize.py\n```",
