  "response": "## Analyse\nJe vais créer des tests unitaires complets pour `tools/summarize.py` en me basant sur les learnings : tests avec assertions vérifiables plutôt que prints, cas d'entrée/sortie connus, validation de la structure et longueur des résumés.\n\n```python path: tests/test_summarize.py\nimport unittest\nimport sys\nimport os\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))\n\nfrom tools.summarize import summarize_text\n\nclass TestSummarize(unittest.TestCase):\n    \n    def test_empty_text(self):\n        \"\"\"Test avec texte vide\"\"\"\n        result = summarize_text(\"\")\n        self.assertEqual(result, \"\")\n    \n    def test_single_sentence(self):\n        \"\"\"Test avec une seule phrase\"\"\"\n        text = \"Ceci est une phrase unique.\"\n        result = summarize_text(text)\n        self.assertEqual(result, text)\n        self.assertIsInstance(result, str)\n    \n    def test_two_sentences_returns_first(self):\n        \"\"\"Test avec deux phrases - doit retourner la première\"\"\"\n        text = \"Première phrase importante. Deuxième phrase moins importante.\"\n        result = summarize_text(text)\n        expected = \"Première phrase importante.\"\n        self.assertEqual(result, expected)\n        self.assertTrue(len(result) < len(text))\n    \n    def test_multiple_sentences_length_constraint(self):\n        \"\"\"Test que le résumé respecte la contrainte de longueur\"\"\"\n        text = \"Une phrase. Deux phrases. Trois phrases. Quatre phrases. Cinq phrases.\"\n        result = summarize_text(text)\n        # Le résumé doit être plus court que l'original\n        self.assertTrue(len(result) < len(text))\n        # Le résumé ne doit pas être vide\n        self.assertTrue(len(result) > 0)\n        # Le résumé doit se terminer par un point\n        self.assertTrue(result.endswith('.'))\n    \n    def test_long_text_summarization(self):\n        \"\"\"Test avec un texte long pour vérifier la réduction\"\"\"\n        text = (\"Python est un langage de programmation. \"\n                \"Il est facile à apprendre et puissant. \"\n                \"Python supporte la programmation orientée objet. \"\n                \"Il a une syntaxe claire et lisible. \"\n                \"Python est utilisé dans de nombreux domaines. \"\n                \"L'intelligence artificielle utilise beaucoup Python. \"\n                \"Les développeurs apprécient sa simplicité.\")\n        \n        result = summarize_text(text)\n        \n        # Vérifications de structure\n        self.assertIsInstance(result, str)\n        self.assertTrue(len(result) > 0)\n        self.assertTrue(result.endswith('.'))\n        \n        # Vérification de la réduction\n        original_sentences = text.count('.')\n        result_sentences = result.count('.')\n        self.assertTrue(result_sentences <= original_sentences)\n        \n        # Le résumé doit être significativement plus court\n        self.assertTrue(len(result) < len(text) * 0.8)\n    \n    def test_whitespace_handling(self):\n        \"\"\"Test la gestion des espaces et caractères spéciaux\"\"\"\n        text = \"  Phrase avec espaces.   Autre phrase.  \"\n        result = summarize_text(text)\n        # Le résultat ne doit pas commencer ou finir par des espaces\n        self.assertEqual(result, result.strip())\n        self.assertTrue(len(result) > 0)\n    \n    def test_return_type_consistency(self):\n        \"\"\"Test que la fonction retourne toujours une string\"\"\"\n        test_cases = [\n            \"\",\n            \"Une phrase.\",\n            \"Première. Deuxième. Troisième.\",\n            \"   Espaces   partout   .   \"\n        ]\n        \n        for text in test_cases:\n            result = summarize_text(text)\n            self.assertIsInstance(result, str, f\"Failed for input: '{text}'\")\n\nif __name__ == '__main__':\n    unittest.main(verbosity=2)\n```\n\n```bash\npython tests/test_summarize.py\n```",
