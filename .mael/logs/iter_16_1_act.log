  "response": "## Analyse\nJe vais implémenter une fixture `initial_state` dans `tests/test_integration.py` qui charge un état initial via un stub fallback. La fixture utilisera le pattern `robust_import_with_stub` et inclura une assertion immédiate pour valider l'état chargé.\n\n```python path: tests/test_integration.py\n\"\"\"Tests d'intégration pour MAEL avec chargement d'état.\"\"\"\n\nimport pytest\nimport sys\nimport os\nfrom pathlib import Path\n\n# Ajouter le répertoire parent au path pour les imports\nsys.path.insert(0, str(Path(__file__).parent.parent))\n\ndef robust_import_with_stub():\n    \"\"\"Import robuste avec fallback stub si le module n'existe pas.\"\"\"\n    try:\n        from src.state_manager import StateManager\n        return StateManager\n    except ImportError:\n        # Stub fallback si le module source n'existe pas\n        class StateManagerStub:\n            def __init__(self):\n                self.current_iteration = 16\n                self.phase = \"AGIR\"\n                self.skills_count = 10\n                \n            def load_state(self, source=\"mock\"):\n                \"\"\"Charge un état initial mock ou depuis fichier.\"\"\"\n                if source == \"mock\":\n                    return MockState()\n                else:\n                    # Simulation de chargement depuis fichier\n                    return MockState(iteration=1, phase=\"ANALYSER\")\n        \n        return StateManagerStub\n\nclass MockState:\n    \"\"\"État mock pour les tests.\"\"\"\n    def __init__(self, iteration=16, phase=\"AGIR\"):\n        self.current_iteration = iteration\n        self.phase = phase\n        self.skills_count = 10\n        self.learnings = []\n        self.is_valid = True\n\n@pytest.fixture\ndef state_manager():\n    \"\"\"Fixture qui retourne un StateManager (réel ou stub).\"\"\"\n    StateManager = robust_import_with_stub()\n    return StateManager()\n\n@pytest.fixture\ndef initial_state(state_manager):\n    \"\"\"Fixture qui charge l'état initial et valide sa structure.\"\"\"\n    # Étape 1: Charger l'état\n    state = state_manager.load_state(source=\"mock\")\n    \n    # Étape 2: Assertion immédiate pour valider le contrat\n    assert state.current_iteration is not None, \"L'état doit avoir une itération courante\"\n    assert state.phase is not None, \"L'état doit avoir une phase\"\n    assert hasattr(state, 'is_valid'), \"L'état doit avoir un attribut is_valid\"\n    \n    return state\n\ndef test_state_loading_basic(initial_state):\n    \"\"\"Test que l'état est chargé avec les attributs de base.\"\"\"\n    assert initial_state.current_iteration >= 1\n    assert initial_state.phase in [\"ANALYSER\", \"AGIR\", \"APPRENDRE\"]\n    assert initial_state.is_valid is True\n\ndef test_state_loading_structure(initial_state):\n    \"\"\"Test que l'état a la structure attendue.\"\"\"\n    required_attrs = ['current_iteration', 'phase', 'skills_count', 'learnings']\n    for attr in required_attrs:\n        assert hasattr(initial_state, attr), f\"Attribut manquant: {attr}\"\n\ndef test_state_manager_mock_vs_file(state_manager):\n    \"\"\"Test que le state_manager peut charger depuis différentes sources.\"\"\"\n    mock_state = state_manager.load_state(source=\"mock\")\n    file_state = state_manager.load_state(source=\"file\")\n    \n    # Les deux doivent être valides mais peuvent différer\n    assert mock_state.current_iteration is not None\n    assert file_state.current_iteration is not None\n    assert mock_state.phase is not None\n    assert file_state.phase is not None\n\nif __name__ == \"__main__\":\n    # Test rapide d'infrastructure\n    print(\"=== Test d'infrastructure ===\")\n    StateManager = robust_import_with_stub()\n    manager = StateManager()\n    state = manager.load_state()\n    print(f\"État chargé: iteration={state.current_iteration}, phase={state.phase}\")\n    print(\"✓ Infrastructure OK\")\n```\n\n```bash\npython tests/test_integration.py\n```",
