  "response": "## Analyse\nJe vais améliorer le scoring en implémentant un TF simple : calculer la fréquence des mots, puis scorer chaque phrase selon la somme des fréquences de ses mots. Je garde l'interface existante et ajoute des stop words français basiques.\n\n```python path: tools/summarize.py\nimport re\nfrom collections import Counter\n\ndef summarize(text, max_sentences=3):\n    \"\"\"\n    Résume un texte en sélectionnant les phrases les plus importantes\n    basé sur un scoring TF simplifié.\n    \"\"\"\n    if not text or not text.strip():\n        return \"\"\n    \n    # Découpage en phrases\n    sentences = re.split(r'[.!?]+', text.strip())\n    sentences = [s.strip() for s in sentences if s.strip()]\n    \n    if len(sentences) <= max_sentences:\n        return '. '.join(sentences) + '.'\n    \n    # Stop words français basiques\n    stop_words = {\n        'le', 'la', 'les', 'un', 'une', 'des', 'du', 'de', 'et', 'ou', 'mais',\n        'car', 'donc', 'or', 'ni', 'que', 'qui', 'quoi', 'dont', 'où', 'ce',\n        'cette', 'ces', 'son', 'sa', 'ses', 'mon', 'ma', 'mes', 'ton', 'ta',\n        'tes', 'notre', 'nos', 'votre', 'vos', 'leur', 'leurs', 'je', 'tu',\n        'il', 'elle', 'nous', 'vous', 'ils', 'elles', 'me', 'te', 'se', 'nous',\n        'vous', 'se', 'à', 'au', 'aux', 'en', 'dans', 'sur', 'sous', 'avec',\n        'sans', 'pour', 'par', 'vers', 'chez', 'est', 'sont', 'était', 'étaient',\n        'être', 'avoir', 'a', 'ont', 'avait', 'avaient'\n    }\n    \n    # Extraction et comptage des mots\n    all_words = []\n    for sentence in sentences:\n        words = re.findall(r'\\b[a-zA-ZÀ-ÿ]+\\b', sentence.lower())\n        words = [w for w in words if w not in stop_words and len(w) > 2]\n        all_words.extend(words)\n    \n    if not all_words:\n        return sentences[0] + '.'\n    \n    # Calcul des fréquences (TF)\n    word_freq = Counter(all_words)\n    \n    # Scoring des phrases\n    sentence_scores = []\n    for i, sentence in enumerate(sentences):\n        words = re.findall(r'\\b[a-zA-ZÀ-ÿ]+\\b', sentence.lower())\n        words = [w for w in words if w not in stop_words and len(w) > 2]\n        \n        if not words:\n            score = 0\n        else:\n            score = sum(word_freq[word] for word in words) / len(words)\n        \n        sentence_scores.append((score, i, sentence))\n    \n    # Sélection des meilleures phrases\n    sentence_scores.sort(reverse=True, key=lambda x: x[0])\n    selected = sentence_scores[:max_sentences]\n    \n    # Tri par ordre d'apparition original\n    selected.sort(key=lambda x: x[1])\n    \n    result = '. '.join(s[2] for s in selected) + '.'\n    return result\n\nif __name__ == \"__main__\":\n    # Test simple\n    test_text = \"\"\"\n    L'intelligence artificielle est une technologie révolutionnaire. \n    Elle transforme de nombreux secteurs d'activité. \n    Les algorithmes d'apprentissage automatique permettent aux machines d'apprendre. \n    Cette technologie soulève aussi des questions éthiques importantes. \n    L'avenir de l'IA dépendra de notre capacité à la réguler.\n    \"\"\"\n    \n    result = summarize(test_text, 2)\n    print(\"Résumé:\", result)\n    \n    # Test cas limite\n    short_text = \"Une seule phrase.\"\n    result2 = summarize(short_text, 3)\n    print(\"Texte court:\", result2)\n```\n\n```bash\npython tools/summarize.py\n```",
