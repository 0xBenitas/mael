  "response": "## Analyse\nJe vais implémenter une fixture `initial_state` dans `tests/test_integration.py` qui charge un état initial via un state manager avec fallback stub. La fixture utilisera le pattern `robust_import_with_stub` et assertera immédiatement un attribut pour valider l'état chargé.\n\n```python path: tests/test_integration.py\nimport pytest\nimport sys\nimport os\nfrom pathlib import Path\n\n# Add project root to path for imports\nproject_root = Path(__file__).parent.parent\nsys.path.insert(0, str(project_root))\n\n# Robust import with stub fallback\ntry:\n    from src.state_manager import StateManager\n    from src.models import State\nexcept ImportError:\n    # Stub fallback when modules don't exist yet\n    class State:\n        def __init__(self):\n            self.iteration = 1\n            self.phase = \"AGIR\"\n            self.skills = {}\n            self.learnings = []\n            self.confidence = 0.8\n    \n    class StateManager:\n        def __init__(self):\n            pass\n        \n        def load_state(self, path=None):\n            return State()\n        \n        def save_state(self, state, path=None):\n            pass\n\n\n@pytest.fixture\ndef initial_state():\n    \"\"\"Fixture qui charge l'état initial et valide sa structure.\"\"\"\n    state_manager = StateManager()\n    state = state_manager.load_state()\n    \n    # Assertion immédiate pour valider le contrat\n    assert state.iteration is not None, \"L'état doit avoir un numéro d'itération\"\n    assert hasattr(state, 'phase'), \"L'état doit avoir une phase\"\n    assert hasattr(state, 'skills'), \"L'état doit avoir des skills\"\n    \n    return state\n\n\ndef test_state_loading_basic(initial_state):\n    \"\"\"Test basique du chargement d'état.\"\"\"\n    assert initial_state is not None\n    assert initial_state.iteration >= 1\n    assert initial_state.phase in [\"AGIR\", \"OBSERVER\", \"ORIENTER\", \"DÉCIDER\"]\n\n\ndef test_state_attributes_exist(initial_state):\n    \"\"\"Test que tous les attributs critiques existent.\"\"\"\n    required_attrs = ['iteration', 'phase', 'skills', 'learnings']\n    for attr in required_attrs:\n        assert hasattr(initial_state, attr), f\"Attribut manquant: {attr}\"\n\n\ndef test_state_manager_instantiation():\n    \"\"\"Test que le StateManager peut être instancié.\"\"\"\n    manager = StateManager()\n    assert manager is not None\n\n\ndef test_state_manager_load_method():\n    \"\"\"Test que la méthode load_state existe et fonctionne.\"\"\"\n    manager = StateManager()\n    state = manager.load_state()\n    assert state is not None\n    assert hasattr(state, 'iteration')\n\n\nclass TestStateIntegration:\n    \"\"\"Tests d'intégration pour le système d'état.\"\"\"\n    \n    def test_full_state_cycle(self, initial_state):\n        \"\"\"Test du cycle complet: charger -> modifier -> sauver.\"\"\"\n        # Charger\n        assert initial_state.iteration is not None\n        \n        # Modifier\n        original_iteration = initial_state.iteration\n        initial_state.iteration += 1\n        \n        # Vérifier modification\n        assert initial_state.iteration == original_iteration + 1\n    \n    def test_state_persistence_mock(self):\n        \"\"\"Test de persistance avec mock.\"\"\"\n        manager = StateManager()\n        state = manager.load_state()\n        \n        # Sauvegarder (mock)\n        manager.save_state(state)\n        \n        # Recharger\n        reloaded_state = manager.load_state()\n        assert reloaded_state is not None\n```\n\n```bash\npytest tests/test_integration.py -v --collect-only\n```",
