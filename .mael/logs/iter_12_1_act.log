  "response": "## Analyse\nJe vais implémenter une fixture `initial_state` dans `tests/test_integration.py` qui charge l'état initial avec le pattern `robust_import_with_stub`. La fixture utilisera un fallback stub si le module source n'existe pas, et assertera immédiatement la validité de l'état chargé.\n\n```python path: tests/test_integration.py\nimport pytest\nimport sys\nimport os\nfrom pathlib import Path\n\n# Robust import with stub fallback\ntry:\n    from src.state_manager import StateManager\n    from src.models import State\nexcept ImportError:\n    # Fallback stub implementation\n    sys.path.insert(0, str(Path(__file__).parent))\n    \n    class State:\n        def __init__(self):\n            self.version = \"1.0.0\"\n            self.data = {\"initialized\": True}\n            self.timestamp = \"2024-01-01T00:00:00Z\"\n    \n    class StateManager:\n        def load_state(self):\n            return State()\n        \n        def save_state(self, state):\n            return True\n\n\n@pytest.fixture\ndef initial_state():\n    \"\"\"Fixture qui charge l'état initial et valide sa structure.\"\"\"\n    state_manager = StateManager()\n    state = state_manager.load_state()\n    \n    # Assertion immédiate pour valider le contrat\n    assert state.version is not None, \"State must have a version\"\n    assert hasattr(state, 'data'), \"State must have data attribute\"\n    \n    return state\n\n\ndef test_state_loading_basic(initial_state):\n    \"\"\"Test basique du chargement d'état.\"\"\"\n    assert initial_state is not None\n    assert initial_state.version == \"1.0.0\"\n\n\ndef test_state_has_required_attributes(initial_state):\n    \"\"\"Test que l'état a tous les attributs requis.\"\"\"\n    required_attrs = ['version', 'data', 'timestamp']\n    for attr in required_attrs:\n        assert hasattr(initial_state, attr), f\"Missing required attribute: {attr}\"\n\n\ndef test_state_data_structure(initial_state):\n    \"\"\"Test la structure des données d'