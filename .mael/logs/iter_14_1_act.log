tion is not None, \"State must have iteration number\"\n    assert state.phase is not None, \"State must have current phase\"\n    assert hasattr(state, 'is_valid'), \"State must have validity flag\"\n    \n    return state\n\ndef test_state_loading_basic(initial_state):\n    \"\"\"Test that state loads with required attributes\"\"\"\n    assert initial_state.iteration >= 1\n    assert initial_state.phase in ['AGIR', 'OBSERVER', 'ORIENTER', 'DECIDER']\n    assert hasattr(initial_state, 'context')\n\ndef test_state_structure_validation(initial_state):\n    \"\"\"Test that loaded state has expected structure\"\"\"\n    assert hasattr(initial_state, 'skills')\n    assert hasattr(initial_state, 'learnings')\n    assert isinstance(initial_state.skills, list)\n    assert isinstance(initial_state.learnings, list)\n\ndef test_state_manager_infrastructure():\n    \"\"\"Test that StateManager has expected methods\"\"\"\n    manager = StateManager()\n    assert hasattr(manager, 'load_state')\n    assert hasattr(manager, 'save_state')\n    assert callable(manager.load_state)\n    assert callable(manager.save_state)\n\nif __name__ == \"__main__\":\n    # Quick validation\n    manager = StateManager()\n    state = manager.load_state()\n    print(f\"State loaded: iteration={state.iteration}, phase={state.phase}\")\n    print(\"✓ State loading implementation complete\")\n```\n\n```bash\npython tests/test_integration.py\n```",
